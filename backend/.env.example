# Copy this file to .env and fill in real values. Never commit .env.
APP_NAME=WeatherGPT
ENV=development
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,https://anmol4903q.github.io

# Fill these in when Phase 3 (weather data) starts
WEATHER_API_KEY=
GEOCODING_API_KEY=

# Nominatim (OpenStreetMap) reverse geocoding — free, no API key, but their
# usage policy requires a real identifying User-Agent on every request.
# Format: <app>/<version> (<contact email or URL>). Anonymous UAs get blocked.
# Nominatim (OpenStreetMap) reverse geocoding — free, no API key, but their
# usage policy requires a real identifying User-Agent on every request.
# Format: <app>/<version> (<contact email or URL>). Anonymous UAs get blocked.
NOMINATIM_USER_AGENT=WeatherGPT-SIH/1.0 (put-your-real-email-here@example.com)

# Gemini (Phase 5 — AI assistant). Free tier is Flash-only (Pro isn't free
# anymore as of April 2026) and rate-limited (~10-15 RPM, a few hundred to
# ~1500 requests/day depending on exact model). Model IDs churn fast in
# this family — check https://ai.google.dev/gemini-api/docs/models if this
# has been sitting unused for a while.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
